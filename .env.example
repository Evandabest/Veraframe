# Copy to .env and fill in. .env is gitignored.

# Path to the Blender executable. Leave blank to use `blender` from PATH.
BLENDER_PATH=

# LLM provider configuration.
# One of: openai, anthropic, gemini, ollama
VERAFRAME_LLM_PROVIDER=openai
VERAFRAME_LLM_MODEL=gpt-4o

# Provider API keys (set only the one you use).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama host (only used if VERAFRAME_LLM_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434
